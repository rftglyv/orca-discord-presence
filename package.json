{
  "name": "orca-discord-presence",
  "version": "0.3.0",
  "description": "Publishes your Orca agent fleet's activity to Discord Rich Presence.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
